<Window x:Class="Concilium.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Concilium"
        Title="Concilium" Width="1400" Height="900" MinWidth="900" MinHeight="600"
        Icon="icon.ico" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Sans}" Foreground="{StaticResource Text}" FontSize="15"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AllowDrop="True" PreviewDragOver="Window_DragOver" PreviewDrop="Window_Drop">
    <!-- No system title bar: the app's own header is the caption (drag, double-click, snap all work). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <!-- Soft aura in the background, the only decoration. -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="900" Height="900" Canvas.Left="-300" Canvas.Top="-360">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#668fae8a" Offset="0"/><GradientStop Color="#008fae8a" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="900" Height="900" Canvas.Left="800" Canvas.Top="300">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#99f3eedb" Offset="0"/><GradientStop Color="#00f3eedb" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinBtn" Style="{StaticResource Caption}" Content="&#xE921;" Click="Min_Click"/>
            <Button x:Name="MaxBtn" Style="{StaticResource Caption}" Content="&#xE922;" Click="Max_Click"/>
            <Button x:Name="CloseBtn" Style="{StaticResource CaptionClose}" Content="&#xE8BB;" Click="Close_Click"/>
        </StackPanel>

        <Grid Margin="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top: brand, people, map toggle. -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,138,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="4,0,24,0">
                    <Viewbox Width="30" Height="30" Margin="0,0,10,0">
                        <Canvas Width="64" Height="64">
                            <Ellipse Width="62" Height="62" Canvas.Left="1" Canvas.Top="1" Fill="#e4ece7"/>
                            <Canvas x:Name="Petals"/>
                            <Ellipse Width="8.4" Height="8.4" Canvas.Left="27.8" Canvas.Top="27.8" Fill="#f7f5ec"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Concilium" FontFamily="{StaticResource Serif}" FontSize="21" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="People" Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="MapBtn" Style="{StaticResource Ghost}" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Map_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="PanelCol" Width="400"/>
                </Grid.ColumnDefinitions>

                <!-- Left: conversations and memory. -->
                <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="12">
                    <DockPanel>
                        <Button x:Name="NewChatBtn" DockPanel.Dock="Top" Style="{StaticResource Primary}" HorizontalAlignment="Stretch" Click="NewChat_Click"/>
                        <TextBlock x:Name="ChatsTitle" DockPanel.Dock="Top" Margin="8,18,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                        <StackPanel x:Name="Memory" DockPanel.Dock="Bottom" Margin="4,10,4,0"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SessionsList"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Center: the conversation. -->
                <Grid Grid.Column="1" Margin="16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="0,4,14,4">
                        <StackPanel x:Name="Messages" MaxWidth="820" Margin="8,8,8,16"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" MaxWidth="836">
                        <WrapPanel x:Name="Actions" Margin="0,8,0,0"/>
                        <WrapPanel x:Name="Attached" Visibility="Collapsed"/>
                        <Border Style="{StaticResource Panel}" Background="{StaticResource GlassStrong}" CornerRadius="22" Padding="6,6,6,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="AttachBtn" Style="{StaticResource Ghost}" Width="42" Height="42" Padding="0" Tag="21"
                                        VerticalAlignment="Bottom" Margin="0,0,4,0" Click="Attach_Click">
                                    <Path Data="M16.5,6.5 L8.6,14.4 A2,2 0 0 0 11.4,17.2 L19,9.6 A4,4 0 0 0 13.3,3.9 L5.6,11.6 A6,6 0 0 0 14.1,20.1 L20,14.2"
                                          Stroke="{StaticResource Accent}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="22" Height="22" Stretch="Uniform"/>
                                </Button>
                                <TextBlock x:Name="Placeholder" Grid.Column="1" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="2,0,0,0"
                                           IsHitTestVisible="False" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBox x:Name="Input" Grid.Column="1" BorderThickness="0" Background="Transparent" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalAlignment="Center" MaxHeight="220" VerticalScrollBarVisibility="Auto" FontSize="15.5" Padding="0,6"
                                         CaretBrush="{StaticResource Accent}" PreviewKeyDown="Input_KeyDown" TextChanged="Input_TextChanged"/>
                                <Button x:Name="SendBtn" Grid.Column="2" Style="{StaticResource Primary}" Width="42" Height="42" Padding="0" Tag="21"
                                        VerticalAlignment="Bottom" Margin="8,0,0,0" Click="Send_Click">
                                    <Grid>
                                        <Path x:Name="SendIcon" Data="M12,19 V5 M6,11 L12,5 L18,11" Stroke="{StaticResource Ink}" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/>
                                        <Rectangle x:Name="StopIcon" Width="11" Height="11" RadiusX="2.5" RadiusY="2.5" Fill="{StaticResource Ink}" Visibility="Collapsed"/>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Right: map and notes. -->
                <Border x:Name="PanelBox" Grid.Column="2" Style="{StaticResource Panel}" Padding="12">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button x:Name="ClosePanelBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="8" Click="Map_Click">
                                <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{StaticResource Muted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="TabMap" Style="{StaticResource PillActive}" Click="TabMap_Click"/>
                                <Button x:Name="TabNote" Style="{StaticResource Pill}" Click="TabNote_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid>
                            <Grid x:Name="MapTab">
                                <local:GraphView x:Name="Graph"/>
                                <WrapPanel x:Name="Legend" VerticalAlignment="Bottom" Margin="4" IsHitTestVisible="False"/>
                            </Grid>
                            <DockPanel x:Name="NoteTab" Visibility="Collapsed">
                                <TextBlock x:Name="NoteTitle" DockPanel.Dock="Top" FontFamily="{StaticResource Serif}" FontSize="19" Margin="6,0,6,8"/>
                                <FlowDocumentScrollViewer x:Name="NoteView" VerticalScrollBarVisibility="Auto" Padding="0" Margin="0"/>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
