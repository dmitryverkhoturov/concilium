<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <Product>Concilium</Product>
    <Company>Dmitry Verkhoturov</Company>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <!-- Published next to the exe: the folder template (skills, principles) and the Claude Code binary. -->
  <PropertyGroup>
    <ClaudeExe>..\app\node_modules\@anthropic-ai\claude-agent-sdk-win32-x64\claude.exe</ClaudeExe>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\concilium-markdown\**\*" LinkBase="concilium-markdown" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
    <None Include="$(ClaudeExe)" Link="claude\claude.exe" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" Condition="Exists('$(ClaudeExe)')" />
  </ItemGroup>

</Project>
